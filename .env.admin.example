# Mizuki Admin configuration
# Required. Use a long unique passphrase.
ADMIN_PASSWORD=change-this-to-a-long-unique-passphrase

# Keep 127.0.0.1 unless the service is protected by a reverse proxy.
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8787

# Optional: Vercel, Netlify, Cloudflare Pages, or other deployment build hook.
# DEPLOY_HOOK_URL=https://example.com/build-hook

# Optional: automatically pull "projects" from your GitHub / Gitee repositories.
# Set at least one username to enable the "从仓库拉取" button in 数据中心 -> 项目.
# Tokens are only needed for private repos or higher API rate limits:
#   GitHub: https://github.com/settings/tokens  (repo scope, or public_repo)
#   Gitee:  https://gitee.com/profile/personal_access_tokens (projects scope)
GITHUB_USERNAME=
GITEE_USERNAME=
GITHUB_TOKEN=
GITEE_TOKEN=