---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import TechnicalCategoryCards from "@components/TechnicalCategoryCards.astro";
import { getPostsForContentSection } from "@utils/content-sections";
import { getSortedPosts } from "@utils/content-utils";

const posts = getPostsForContentSection(await getSortedPosts(), "technical");
---

<MainGridLayout title="技术资料" description="按技术分类浏览文章">
	<section class="card-base mb-4 rounded-[var(--radius-large)] p-6"><p class="mb-1 text-sm font-medium text-[var(--primary)]">TECHNICAL LIBRARY</p><h1 class="text-3xl font-bold text-90">技术资料</h1><p class="mt-2 text-60">选择一个分类开始阅读。</p></section>
	<TechnicalCategoryCards posts={posts} />
</MainGridLayout>
