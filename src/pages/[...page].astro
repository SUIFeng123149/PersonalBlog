---
import type { GetStaticPaths } from "astro";
import ContentSectionCards from "../components/ContentSectionCards.astro";
import PostPage from "../components/PostPage.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getFeaturedPosts } from "../utils/content-sections";
import { getSortedPosts } from "../utils/content-utils";

export const getStaticPaths = (async () => [
	{ params: { page: undefined } },
]) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const allBlogPosts = await getSortedPosts();
const featuredPosts = getFeaturedPosts(allBlogPosts);
---

<MainGridLayout>
    <ContentSectionCards posts={allBlogPosts}></ContentSectionCards>
    <section aria-labelledby="featured-posts-title" class="mb-3 px-1 onload-animation">
        <p class="text-sm font-medium text-[var(--primary)]">FEATURED</p>
        <h2 id="featured-posts-title" class="text-2xl font-bold text-90">精选文章</h2>
    </section>
    <PostPage posts={featuredPosts}></PostPage>
</MainGridLayout>
