---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { now } from "../data/now";

const sections = [
	{ title: "专注", icon: "material-symbols:target", items: now.focus },
	{ title: "学习", icon: "material-symbols:school", items: now.learning },
	{ title: "构建", icon: "material-symbols:construction", items: now.building },
];
---

<MainGridLayout title="此刻" description="我现在正在做什么和学什么">
	<section class="card-base p-6 md:p-9 mb-4">
		<div class="flex items-center gap-3 mb-2">
			<Icon name="material-symbols:today" class="text-3xl text-[var(--primary)]" />
			<h1 class="text-3xl font-bold text-90">此刻</h1>
		</div>
		<p class="text-50 text-sm">最后更新：{now.updated}</p>
	</section>
	<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
		{sections.map((section) => (
			<section class="card-base p-6">
				<div class="flex items-center gap-2 mb-4">
					<Icon name={section.icon} class="text-2xl text-[var(--primary)]" />
					<h2 class="text-lg font-bold text-90">{section.title}</h2>
				</div>
				<ul class="space-y-3 text-75">
					{section.items.map((item) => <li class="flex gap-2"><span class="text-[var(--primary)]">*</span><span>{item}</span></li>)}
				</ul>
			</section>
		))}
	</div>
	<section class="card-base p-6 mb-4 flex gap-3 items-start">
		<Icon name="material-symbols:mail-outline-rounded" class="text-2xl text-[var(--primary)] shrink-0" />
		<p class="text-75">{now.availability}</p>
	</section>
</MainGridLayout>
