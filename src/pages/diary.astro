---
import { siteConfig } from "../config";
import { diaryEntries } from "../data/diary";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";

if (!siteConfig.featurePages.diary) return Astro.redirect("/404/");

const visibleEntries = diaryEntries
	.filter((entry) => !entry.hidden)
	.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
	.slice(0, 30);

function formatTime(dateString: string) {
	const diff = Math.max(0, Date.now() - new Date(dateString).getTime());
	const minutes = Math.floor(diff / 60000);
	if (minutes < 60) return `${minutes}${i18n(I18nKey.diaryMinutesAgo)}`;
	if (minutes < 1440)
		return `${Math.floor(minutes / 60)}${i18n(I18nKey.diaryHoursAgo)}`;
	return `${Math.floor(minutes / 1440)}${i18n(I18nKey.diaryDaysAgo)}`;
}
---

<MainGridLayout title={i18n(I18nKey.diary)} description="日常记录">
	<section class="card-base p-4 md:p-6">
		<header class="moments-header mb-6 flex items-center justify-between gap-4">
			<div><h1 class="text-xl md:text-2xl font-bold">{i18n(I18nKey.diary)}</h1><p>{i18n(I18nKey.diarySubtitle)}</p></div>
			<strong>{visibleEntries.length} {i18n(I18nKey.diaryCount)}</strong>
		</header>
		<div class="space-y-4">
			{visibleEntries.map((entry) => <article class="moment-item card-base p-4 md:p-5"><p class="whitespace-pre-wrap leading-relaxed">{entry.content}</p>{entry.images.length > 0 && <div class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-3">{entry.images.map((image) => <img src={image.startsWith("/") ? image : `/${image}`} alt={i18n(I18nKey.diaryImage)} class="aspect-square w-full rounded-lg object-cover" loading="lazy" />)}</div>}<time class="mt-4 block text-sm text-75" datetime={entry.date}>{formatTime(entry.date)}</time></article>)}
			{visibleEntries.length === 0 && <p class="py-12 text-center text-75">暂时还没有日记。</p>}
		</div>
		<p class="mt-8 text-center text-sm italic text-75">{i18n(I18nKey.diaryTips)}</p>
	</section>
</MainGridLayout>

<style>
	.card-base { background: var(--card-bg); border: 1px solid var(--line-divider); border-radius: var(--radius-large); }
	.moments-header { padding: 1.25rem; color: white; border-radius: 1rem; background: linear-gradient(135deg, var(--primary), var(--primary-dark, var(--primary))); }
	.moments-header p { margin-top: .25rem; color: color-mix(in srgb, white 86%, transparent); }
</style>
