---
import type { CollectionEntry } from "astro:content";
import {
	CONTENT_SECTIONS,
	getPostsForContentSection,
} from "@utils/content-sections";
import { url } from "@utils/url-utils";
import { Icon } from "astro-icon/components";

interface Props {
	posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;
---

<section aria-labelledby="content-sections-title" class="mb-6 onload-animation">
	<div class="mb-3 flex items-end justify-between px-1">
		<div>
			<p class="text-sm font-medium text-[var(--primary)]">CONTENT</p>
			<h2 id="content-sections-title" class="text-2xl font-bold text-90">
				浏览内容
			</h2>
		</div>
	</div>

	<div class="grid grid-cols-1 gap-3 md:grid-cols-2">
		{
			CONTENT_SECTIONS.map((section) => {
				const count = getPostsForContentSection(posts, section.slug).length;
				return (
					<a
						href={url(`/category/${section.slug}/`)}
						class="card-base group relative flex min-h-36 flex-col justify-between overflow-hidden rounded-[var(--radius-large)] p-5 transition duration-300 hover:-translate-y-1 hover:shadow-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)]"
					>
						<div class="flex items-start justify-between gap-4">
							<div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[var(--primary)]/10 text-[var(--primary)] transition group-hover:bg-[var(--primary)] group-hover:text-white">
								<Icon name={section.icon} class="text-2xl" />
							</div>
							<span class="rounded-full bg-[var(--primary)]/10 px-2.5 py-1 text-xs font-semibold text-[var(--primary)]">
								{count} 篇
							</span>
						</div>
						<div>
							<h3 class="mb-1 flex items-center gap-1 text-xl font-bold text-90">
								{section.title}
								<Icon
									name="material-symbols:arrow-forward-rounded"
									class="text-lg text-[var(--primary)] opacity-0 transition group-hover:translate-x-1 group-hover:opacity-100"
								/>
							</h3>
							<p class="text-sm font-bold leading-6 text-60">{section.description}</p>
						</div>
					</a>
				);
			})
		}
	</div>
</section>
