{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install",
  "framework": "astro",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/assets/:path*",
      "destination": "https://suifeng-personal-blog.oss-cn-beijing.aliyuncs.com/assets/:path*",
      "permanent": false
    },
    {
      "source": "/pio/:path*",
      "destination": "https://suifeng-personal-blog.oss-cn-beijing.aliyuncs.com/pio/:path*",
      "permanent": false
    },
    {
      "source": "/js/:path*",
      "destination": "https://suifeng-personal-blog.oss-cn-beijing.aliyuncs.com/js/:path*",
      "permanent": false
    },
    {
      "source": "/sakura.png",
      "destination": "https://suifeng-personal-blog.oss-cn-beijing.aliyuncs.com/sakura.png",
      "permanent": false
    }
  ]
}
